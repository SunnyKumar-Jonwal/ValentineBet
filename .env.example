# Copy this file to ".env" and fill in your values.

# Google Gemini API key (https://aistudio.google.com/apikey).
# Leave empty to use the built-in "mock" agent (a naive rule-based simulator).
GEMINI_API_KEY=

# Gemini model to use.
GEMINI_MODEL=gemini-2.5-flash

# "gemini" or "mock". If GEMINI_API_KEY is empty, mock is always used.
LLM_PROVIDER=gemini

PORT=3000
SESSION_SECRET=change-me-local-lab-secret
